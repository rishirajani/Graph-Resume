cv:p-thesis a schema:CreativeWork ;
    schema:name "Semantic Concept Learning in EL++ Knowledge Graphs using Box Embeddings" ;
    gr:kind "Project" ;
    schema:startDate "2026-03" ;
    gr:location "Stuttgart, Germany" ;
    schema:creativeWorkStatus "Master's thesis, ongoing" ;
    gr:highlight "Investigating concept learning with description logics and geometric box embeddings, evaluating semantic similarity and concept prediction in knowledge graphs." ;
