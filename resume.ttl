cv:p-loom a schema:CreativeWork ;
    schema:name "Loom: open-source CSV-to-RDF ontology mapping tool" ;
    gr:kind "Project" ;
    schema:startDate "2026-06" ;
    schema:url "https://github.com/rishirajani/loom" ;
    gr:highlight "Built a locally running TypeScript/React application using N3.js to map spreadsheet columns to RDF vocabularies and generate structured semantic representations.", "Implemented mapping suggestions, datatype matching and integrity checks for duplicate records and unmapped columns; integrated CI checks and 41 Vitest regression tests.", "Runs entirely in the browser with no server or upload; bundles Schema.org and DCAT ontology subsets, offers tiered mapping suggestions, detects duplicate identifiers and IRI collisions, validates the base IRI and exports Turtle. Released under the MIT licence." ;
    gr:used cv:s-ts, cv:s-react, cv:s-n3, cv:s-rdf, cv:s-turtle, cv:s-semmodel, cv:s-s2t, cv:s-dq, cv:s-cicd .

cv:p-heat a schema:CreativeWork ;
    schema:name "Urban Heat Risk Knowledge Graph" ;
    gr:kind "Project" ;
    schema:startDate "2026-05" ;
    schema:endDate "2026-09" ;
    schema:url "https://github.com/rishirajani/UrbanHeatRiskReasoning" ;
    gr:highlight "Integrated CityGML, OpenStreetMap, climate, vegetation and building data into RDF representations; applied SPARQL and semantic reasoning to assess urban heat risk and identify vulnerable buildings." ;
    gr:used cv:s-rdf, cv:s-sparql, cv:s-integration, cv:s-semmodel .

cv:p-arch a schema:CreativeWork ;
    schema:name "Knowledge Graph Applications in Architecture" ;
    gr:kind "Project" ;
    schema:startDate "2026-04" ;
    schema:endDate "2026-09" ;
    gr:highlight "Designed Turtle ontologies for crane navigation and urban landscape analysis; loaded RDF into Neo4j with neosemantics for Cypher-based querying of spatial relationships and constraints." ;
    gr:used cv:s-turtle, cv:s-ontology, cv:s-rdf, cv:s-neo4j, cv:s-n10s, cv:s-cypher .

cv:p-rossmann a schema:CreativeWork ;
    schema:name "Rossmann Store Sales Prediction" ;
    gr:kind "Project" ;
    schema:description "Final-year Computer Engineering project comparing machine learning models for retail sales forecasting, plus a web application that uses them to predict daily or weekly sales for any of the 1,115 stores of the Dirk Rossmann GmbH chain." ;
    schema:startDate "2018" ;
    schema:endDate "2019-04" ;
    schema:creativeWorkStatus "Bachelor's final-year project, team of three" ;
    gr:highlight "Performed a comparative analysis of Linear Regression, K-Nearest Neighbors and XGBoost regression on the Kaggle Rossmann Store Sales dataset to determine the merits and drawbacks of each model.", "Cleaned the data and selected 11 features using correlation heatmaps, Variance Inflation Factors and chi-square tests, discarding highly collinear features such as Promo2.", "Evaluated the models on an 80/20 split with RMSE and adjusted R²: XGBoost reached an RMSE of 457 and adjusted R² of 97.8%, against 1,015 and 89.3% for KNN and 1,545 and 75.2% for Linear Regression.", "Developed a Django web application with employee login that loads the serialized models and predicts a store's sales for a day or a chosen week with all three models, comparing results with promotions on and off.", "In hindsight, these scores overstate real forecasting accuracy: same-day customer counts, unknown at prediction time, were used as a feature, and the test set was a random rather than time-based split. A leakage-free evaluation would drop Customers, hold out the final weeks, and tune on a separate validation set." ;
    gr:partOf cv:e-be ;
    gr:used cv:s-python, cv:s-sklearn, cv:s-xgboost, cv:s-regression, cv:s-featsel, cv:s-django, cv:s-sqlite, cv:s-web .

