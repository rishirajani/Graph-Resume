 {
  "@id": "https://rishirajani.github.io/Graph-Resume/vocab",
  "@type": [
   "http://www.w3.org/2002/07/owl#Ontology"
  ],
  "http://purl.org/dc/terms/created": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-11-03"
   }
  ],
  "http://purl.org/dc/terms/creator": [
   {
    "@value": "Rishi Rajani"
   }
  ],
  "http://purl.org/dc/terms/description": [
   {
    "@language": "en",
    "@value": "A small vocabulary for describing a person's career as a knowledge graph:\nthe roles they held, what they studied and built, the skills each of those used, and how\nthe pieces connect. It builds on schema.org for the kinds of things (people, organisations,\ncredentials, creative works, defined terms) and adds the relations between them that\nschema.org doesn't have, or only has as plain text."
   }
  ],
  "http://purl.org/dc/terms/license": [
   {
    "@id": "https://creativecommons.org/licenses/by/4.0/"
   }
  ],
  "http://purl.org/dc/terms/rights": [
   {
    "@language": "en",
    "@value": "© 2026 Rishi Rajani. This vocabulary and its documentation are licensed under CC BY 4.0. The resume data described with it is not."
   }
  ],
  "http://purl.org/dc/terms/title": [
   {
    "@language": "en",
    "@value": "Graph Resume vocabulary"
   }
  ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix": [
   {
    "@value": "gr"
   }
  ],
  "http://purl.org/vocab/vann/preferredNamespaceUri": [
   {
    "@value": "https://rishirajani.github.io/Graph-Resume/vocab#"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
   {
    "@id": "https://schema.org/"
   },
   {
    "@id": "http://www.w3.org/2004/02/skos/core"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionIRI": [
   {
    "@id": "https://rishirajani.github.io/Graph-Resume/vocab/1.0"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionInfo": [
   {
    "@value": "1.0"
   }
  ]
 },
